# Combined producer + forwarder + job server.
# Standalone - all sources are fetched from GitHub.
# Build context is unused.
#
# Build with:
#
#   podman build -f developerdocs/example/Containerfile.producer -t lclstream-producer developerdocs/example/
#
# Runtime: psik_api serves job submission over mTLS (certified).
# psik local backend spawns lclstreamer and lclstream-fastcache as
# subprocesses; they inherit the pixi-activated environment from the
# entrypoint so no separate environment setup is needed in job scripts.

# ── Stage 1: lclstreamer pixi environment ────────────────────────────────────
FROM ghcr.io/prefix-dev/pixi:0.70.2 AS lclstreamer-build

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*

RUN git clone --branch main --depth=1 \
    https://github.com/lclstream/lclstreamer.git /app/lclstreamer

ARG PSANA_VERSION=2extmpi

RUN cd /app/lclstreamer && pixi install --locked -q -e psana${PSANA_VERSION} \
    && pixi clean cache --yes \
    && rm -rf /root/.cache/rattler

RUN cd /app/lclstreamer \
    && pixi shell-hook -e psana${PSANA_VERSION} -s bash > /shell-hook \
    && printf '#!/bin/bash\n' > /app/entrypoint.sh \
    && cat /shell-hook >> /app/entrypoint.sh \
    && printf 'exec "$@"\n' >> /app/entrypoint.sh

# ── Stage 2: fastcache binary ─────────────────────────────────────────────────
FROM docker.io/debian:trixie-slim AS fastcache-build

RUN apt-get update && apt-get install -y --no-install-recommends \
    cmake ninja-build git curl zip unzip tar pkg-config \
    build-essential ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN git clone --filter=blob:none https://github.com/microsoft/vcpkg /opt/vcpkg \
    && /opt/vcpkg/bootstrap-vcpkg.sh -disableMetrics

ENV VCPKG_ROOT=/opt/vcpkg

RUN git clone --branch main --depth=1 \
    https://github.com/lclstream/fastcache.git /build

WORKDIR /build

RUN --mount=type=cache,target=/root/.cache/vcpkg \
    VCPKG_BINARY_SOURCES="clear;files,/root/.cache/vcpkg,readwrite" \
    cmake --preset default \
    && cmake --build build --preset default

# ── Stage 3: psik_api on Python 3.13 ─────────────────────────────────────────
# ubuntu:26.04 ships Python 3.14; certified's pyo3 deps don't have 3.14 wheels
# yet. Build on the same trixie slim image the upstream psik_api Dockerfile uses.
FROM python:3.13-slim-trixie AS psik-build
ARG PSIK_API_VERSION=3.0.0

RUN apt-get update && apt-get install -y --no-install-recommends git rc \
    && rm -rf /var/lib/apt/lists/*

RUN pip install git+https://github.com/frobnitzem/psik_api@v${PSIK_API_VERSION}

# ── Runtime ───────────────────────────────────────────────────────────────────
FROM ubuntu:26.04
ARG PSANA_VERSION=2extmpi

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        file ca-certificates git rc openmpi-bin libopenmpi-dev \
    && rm -rf /var/lib/apt/lists/*

# Prevent OpenMPI from trying to launch remote shells when running single-node.
ENV OMPI_MCA_plm_rsh_agent=/bin/true

# lclstreamer pixi environment + activation scripts
COPY --from=lclstreamer-build \
    /app/lclstreamer/.pixi/envs/psana${PSANA_VERSION} \
    /app/lclstreamer/.pixi/envs/psana${PSANA_VERSION}
COPY --from=lclstreamer-build --chmod=0755 /app/entrypoint.sh /app/entrypoint.sh
COPY --from=lclstreamer-build \
    /app/lclstreamer/activation-psana1.sh \
    /app/lclstreamer/activation-psana2.sh \
    /app/lclstreamer/
# editable install points into src/ — must be present in the runtime image
COPY --from=lclstreamer-build /app/lclstreamer/pyproject.toml /app/lclstreamer/pyproject.toml
COPY --from=lclstreamer-build /app/lclstreamer/src /app/lclstreamer/src

# fastcache forwarder binary
COPY --from=fastcache-build /build/build/lclstream-fastcache /usr/local/bin/lclstream-fastcache

# Python 3.13 interpreter + psik_api + certified (scripts, site-packages, certs)
# /usr/local on a fresh ubuntu:26.04 image is empty, so no conflicts.
COPY --from=psik-build /usr/local /usr/local

# Self-signed cert for dev/local use; mount /etc/certified to override.
RUN certified init 'LCLStream Producer' \
        --host 127.0.0.1 \
        --host ::1 \
        --host localhost

# Main configuration file for psik_api access
COPY ./psik_api.json /etc/psik_api.json

# Auxilliary, optional configuration file for running
# psik within the container.
# Defines local (direct execution) and api (localhost:4433 -> psik_api) backends.
COPY ./psik.json /etc/psik.json

# Can create and run as a user, but then the /etc/certified
# credentials would no longer be readable.
#
#RUN useradd --system --home-dir /app/lclstreamer lclstream \
#    && chown -R lclstream:lclstream /app/lclstreamer \
#    && mkdir -p /tmp/psik_api && chown lclstream:lclstream /tmp/psik_api
#USER lclstream

WORKDIR /app/lclstreamer
ENTRYPOINT ["/app/entrypoint.sh"]
CMD ["certified", "serve", "psik_api.main:app", "https://0.0.0.0:4433"]
